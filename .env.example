# Конфигурация для работы с API hh.ru
# Скопируйте этот файл в .env и заполните реальными значениями

# API ключ для hh.ru (если требуется)
# HH_API_KEY=your_api_key_here

# Базовый URL API hh.ru (обычно не требуется изменять)
# HH_API_BASE_URL=https://api.hh.ru

# Таймаут для запросов к API (в секундах)
# REQUEST_TIMEOUT=10
